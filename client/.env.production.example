# Production environment variables for Vercel
# Replace the placeholder values with your actual Render service URLs after deploying the backend.

# Your Render backend URL — set this in Vercel's dashboard under Project > Settings > Environment Variables
VITE_API_URL=https://YOUR_RENDER_SERVICE_NAME.onrender.com/api
VITE_SOCKET_URL=https://YOUR_RENDER_SERVICE_NAME.onrender.com
